---
auths:
  synology_v3:
    version: 3
    username: REPLACE_WITH_SNMPV3_USER
    security_level: authPriv
    password: REPLACE_WITH_SNMPV3_AUTH_PASSWORD
    auth_protocol: SHA
    priv_protocol: AES
    priv_password: REPLACE_WITH_SNMPV3_PRIVACY_PASSWORD

modules:
  synology:
    walk:
      - 1.3.6.1.2.1.1
      - 1.3.6.1.2.1.2
      - 1.3.6.1.2.1.25.2
      - 1.3.6.1.4.1.6574
    max_repetitions: 10
    retries: 2
    timeout: 10s

