{
  "annotations": {"list": []}, "description": "Cluster and guest metrics for the three-node homelab cluster, collected by PVE Exporter through a read-only API token. Nothing is installed on the hypervisors, so every value here is reported by Proxmox itself rather than by an in-guest agent. Guest 399, the isolated restore-drill shell, is intentionally stopped and is excluded from the guest-down alert.", "editable": false, "graphTooltip": 1,
  "panels": [
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "id": 1, "targets": [{"expr": "pve_cpu_usage_ratio{id=~\"node/.*\"}", "legendFormat": "{{id}}"}], "description": "CPU utilization for each of the three cluster nodes, as reported by Proxmox.", "title": "Node CPU", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "id": 2, "targets": [{"expr": "pve_memory_usage_bytes{id=~\"node/.*\"} / pve_memory_size_bytes{id=~\"node/.*\"}", "legendFormat": "{{id}}"}], "description": "Memory used as a fraction of installed RAM per node. pve1 is the constrained one: guests 290, 310 and 320 commit 23.58 GiB of its 31.2 GiB, leaving roughly 7.6 GiB before the hypervisor's own reserve. VM 297 was destroyed on 2026-09-19, which removed the former over-commitment.", "title": "Node memory", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "description": "Local and shared storage utilization. Shared Synology series appear once per node by design.", "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.75}, {"color": "red", "value": 0.9}]}, "unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8}, "id": 3, "targets": [{"expr": "pve_disk_usage_bytes{id=~\"storage/.*\"} / pve_disk_size_bytes{id=~\"storage/.*\"}", "legendFormat": "{{id}}"}], "title": "Storage utilization", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "gridPos": {"h": 5, "w": 6, "x": 0, "y": 17}, "id": 4, "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"expr": "pve_uptime_seconds{id=~\"node/.*\"}", "legendFormat": "{{id}}"}], "description": "Time since each node last booted. An unexpected reset here is the first thing to check after any cluster surprise.", "title": "Node uptime", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "description": "Running QEMU guests, excluding nodes and storage objects.", "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "short"}, "overrides": []}, "gridPos": {"h": 5, "w": 4, "x": 6, "y": 17}, "id": 5, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "sum(pve_up{id=~\"qemu/.*\"} == 1)"}], "title": "Running guests", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "description": "Stopped guests include intentionally powered-off recovery and retained VMs.", "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "short"}, "overrides": []}, "gridPos": {"h": 5, "w": 4, "x": 10, "y": 17}, "id": 6, "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "sum(pve_up{id=~\"qemu/.*\"} == 0)"}], "title": "Stopped guests", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "description": "Exporter-reported guests without a current Proxmox backup.", "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}, "unit": "short"}, "overrides": []}, "gridPos": {"h": 5, "w": 5, "x": 14, "y": 17}, "id": 7, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "max(pve_not_backed_up_total{job=\"pve\"})"}], "title": "Not backed up", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "index": 0, "text": "DOWN"}, "1": {"color": "green", "index": 1, "text": "UP"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "gridPos": {"h": 5, "w": 5, "x": 19, "y": 17}, "id": 8, "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "up{job=\"pve\"}"}], "description": "Scrape health of PVE Exporter itself. If this is down every other panel on this dashboard goes stale, so check it before believing an empty graph.", "title": "PVE exporter", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22}, "id": 9, "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true}}, "targets": [{"expr": "pve_cpu_usage_ratio{id=~\"qemu/.*\"}", "legendFormat": "{{id}}"}], "description": "Per-guest CPU utilization measured by the hypervisor, so it works even for the older guests that have no QEMU guest agent installed.", "title": "Guest CPU", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22}, "id": 10, "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true}}, "targets": [{"expr": "pve_memory_usage_bytes{id=~\"qemu/.*\"} / pve_memory_size_bytes{id=~\"qemu/.*\"}", "legendFormat": "{{id}}"}], "description": "Memory used against each guest's configured maximum. This is the hypervisor's view; it does not distinguish a guest's page cache from real pressure.", "title": "Guest memory", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30}, "id": 11, "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true}}, "targets": [{"expr": "rate(pve_network_receive_bytes_total{id=~\"qemu/.*\"}[5m])", "legendFormat": "RX {{id}}"}, {"expr": "rate(pve_network_transmit_bytes_total{id=~\"qemu/.*\"}[5m])", "legendFormat": "TX {{id}}"}], "description": "Receive and transmit rates per guest, measured at the virtual NIC.", "title": "Guest network throughput", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30}, "id": 12, "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true}}, "targets": [{"expr": "rate(pve_disk_read_bytes_total{id=~\"qemu/.*\"}[5m])", "legendFormat": "Read {{id}}"}, {"expr": "rate(pve_disk_written_bytes_total{id=~\"qemu/.*\"}[5m])", "legendFormat": "Write {{id}}"}], "description": "Read and write rates per guest. VM 300 sits on pve2's spinning disk, so its latency behaves differently from the SSD and NVMe backed guests.", "title": "Guest disk throughput", "type": "timeseries"}
  ],
