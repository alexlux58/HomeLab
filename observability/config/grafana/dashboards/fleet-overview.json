{
  "annotations": {"list": []}, "description": "One-screen health summary for the whole lab: scrape health, firing alerts, and a condensed view of Linux, Proxmox, and Synology. Start here, then open the dedicated dashboard for whatever looks wrong. Node-level Linux panels currently cover VM 310 only until Stage I-G adds the VM 300 agents.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}, "id": 1, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"expr": "sum(up)", "refId": "A"}], "description": "Number of Prometheus scrape targets currently returning data. Compare with the per-job breakdown to the right - a drop of one is a single exporter, a large drop is usually a host or network problem.", "title": "Healthy metric targets", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}, "id": 2, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"expr": "sum(ALERTS{alertstate=\"firing\"})", "refId": "A"}], "description": "Every alert currently firing across all rule groups. Zero is the expected steady state for this lab.", "title": "Firing alerts", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "id": 3, "targets": [{"expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "legendFormat": "{{instance}}"}], "description": "Memory in use as a fraction of total, per Linux host. VM 310 is deliberately capped at 4 GiB because protected VM 290 reserves another 17.58 GiB on pve1, so a persistently high figure here is a reason to re-audit those guests before adding monitoring RAM.", "title": "Linux memory utilization", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}, "id": 4, "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true}}, "targets": [{"expr": "probe_duration_seconds", "legendFormat": "{{job}} {{instance}}"}], "description": "All probe durations on one axis, so an HTTPS slowdown can be checked against DNS and ping at the same moment. If all three rise together the cause is the network, not the service.", "title": "Endpoint, DNS, and ICMP latency", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "description": "Percentage of targets currently healthy for each scrape job.", "fieldConfig": {"defaults": {"max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.9}, {"color": "green", "value": 1}]}, "unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}, "id": 5, "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "avg by (job) (up)", "legendFormat": "{{job}}"}], "title": "Target health by job", "type": "bargauge"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 8, "y": 16}, "id": 6, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "sum(ALERTS{alertstate=\"firing\",severity=\"critical\"}) or vector(0)"}], "description": "Firing alerts at critical severity - these are the ones that page by email through Alertmanager to alerts@example.com.", "title": "Critical alerts", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}, "unit": "short"}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 12, "y": 16}, "id": 7, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "sum(ALERTS{alertstate=\"firing\",severity=\"warning\"}) or vector(0)"}], "description": "Firing alerts at warning severity. These are intended to be read, not acted on immediately.", "title": "Warning alerts", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "description": "Online Proxmox nodes. The expected value is three.", "fieldConfig": {"defaults": {"max": 3, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 2}, {"color": "green", "value": 3}]}, "unit": "short"}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 16, "y": 16}, "id": 8, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "sum(pve_up{id=~\"node/.*\"})"}], "title": "Proxmox nodes", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "description": "Worst current Synology system, power, and fan status; 1 is healthy.", "fieldConfig": {"defaults": {"mappings": [{"options": {"1": {"color": "green", "index": 0, "text": "Healthy"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1.000001}]}}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 20, "y": 16}, "id": 9, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "max({job=\"synology-snmp\",__name__=~\"systemStatus|powerStatus|systemFanStatus|cpuFanStatus\"})"}], "title": "Synology health", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"max": 100, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}, "unit": "percent"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20}, "id": 10, "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "100 * (1 - raidFreeSize{job=\"synology-snmp\",raidName=~\"Volume .*\"} / raidTotalSize{job=\"synology-snmp\",raidName=~\"Volume .*\"})", "legendFormat": "{{raidName}}"}], "description": "Used capacity per Synology volume. Volume 1 holds every backup archive under keep-all=1 and is never pruned, so it only grows - watch its slope, not just its current value.", "title": "Synology volumes", "type": "bargauge"},
    {"datasource": {"type": "prometheus", "uid": "prometheus"}, "description": "Prometheus TSDB block and WAL footprint against the configured 8 GiB retention ceiling.", "fieldConfig": {"defaults": {"max": 8589934592, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 6442450944}, {"color": "red", "value": 7730941133}]}, "unit": "bytes"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20}, "id": 11, "options": {"minVizHeight": 75, "minVizWidth": 75, "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true}, "targets": [{"expr": "prometheus_tsdb_storage_blocks_bytes + prometheus_tsdb_wal_storage_size_bytes"}], "title": "Prometheus retention size", "type": "gauge"}
  ],
  "refresh": "30s",
  "schemaVersion": 41,
